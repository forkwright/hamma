# Format: RULE/name:path/glob

# kanon init scaffolds CI workflows with a split design (rust.yml runs MSRV/feature
# isolation, ci.yml runs shellcheck, others run security/releases). The quality gates
# (fmt, clippy, test) are enforced by `kanon gate` pre-push, not in GitHub Actions.
# These lint rules expect a monolithic CI file that runs everything; our split
# design deliberately does not. Revisit when kanon lint rules catch up to kanon init.
CI/no-clippy-check:.github/workflows/**
CI/no-deny-check:.github/workflows/**
CI/no-format-check:.github/workflows/**
CI/no-test-step:.github/workflows/**

# mitos exports the key hierarchy (MachinePrivate/Public, NodePrivate/Public,
# DiscoPrivate/Public, MachinePublic::from_hex), Tailscale-compatible wire types
# (RegisterRequest, MapRequest, Node, Hostinfo, DnsConfig, DerpMap, ...), and the
# behavioral Config (WireConfig, NoiseConfig, and the DEFAULT_* constants
# documenting their values) that dictyon (and future `histos`) consume by name.
# Every `pub` here IS the library contract — pub(crate) would hide it from the
# other workspace crate. See crates/dictyon/src/*.rs imports of
# `mitos::{keys,types,config}::*`.
RUST/pub-visibility:crates/mitos/src/keys.rs
RUST/pub-visibility:crates/mitos/src/types/**
RUST/pub-visibility:crates/mitos/src/config/**

# dictyon's public surface (ControlClient, Netmap, RegisterOutcome, NoiseHandshake,
# NoiseTransport, ControlConnection, UpgradeRequest, AsyncControlStream, ControlConfig,
# WireError, etc.) is consumed by examples/connect.rs, tests/wire_integration.rs, and
# the future histos coordination server. These items are library API by design — the
# pub modules in lib.rs re-export them. Narrowing to pub(crate) would break both the
# example and the integration test, which live in separate compilation units.
RUST/pub-visibility:crates/dictyon/src/control.rs
RUST/pub-visibility:crates/dictyon/src/noise.rs
RUST/pub-visibility:crates/dictyon/src/transport.rs
RUST/pub-visibility:crates/dictyon/src/wire/**

# gate-attestation.yml deliberately carries no concurrency: block — the
# reusable it calls (hybrid-gate.yml) already declares one, and the reusable's
# own comment states callers must not set a second one under the same key or
# the shared group self-cancels. See the WHY comment above `jobs:` in that
# file for the full rationale.
YAML/missing-concurrency:.github/workflows/gate-attestation.yml
